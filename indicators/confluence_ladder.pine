// strategy_archetype: first_principles
//@version=6
indicator("Confluence Ladder", overlay=true, max_lines_count=100, max_labels_count=100)

// Companion to "Turn Confirmation Levels", answering a different question.
//
// Turn Confirmation Levels groups nearby levels into bands and picks the band
// holding the most levels. This script does not group at all. It lists every
// distinct level above the close, in order, and reports the cumulative count
// of levels a move would clear on the way to each one. That makes the
// trade-off explicit: a nearer level is easier to reach but leaves most of the
// shelf overhead, a further one clears more but sits further from price.
//
// The two scripts can and should disagree. Neither output is a recommendation.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
string grpLeg = "Leg / Fib"
string grpCluster = "Ladder"
string grpVolume = "Volume Filter"
string grpDisplay = "Display"
string grpColors = "Colors"

lookback = input.int(250, "Lookback", minval=20, group=grpLeg)
showPivots = input.bool(true, "Include pivot highs/lows", group=grpCluster)
pivotCount = input.int(50, "Max pivots retained", minval=1, maxval=200, group=grpCluster, tooltip="Safety cap only. Age is the primary filter.")
pivotMaxAge = input.int(250, "Pivot max age (bars)", minval=10, maxval=5000, group=grpCluster, tooltip="Pivots older than this many bars are dropped, matching the Lookback window used for the fibs and swing extremes.")
dedupePct = input.float(0.0, "Merge levels closer than (%)", minval=0.0, step=0.05, group=grpCluster, tooltip="0 counts every level separately. Raise it to treat levels a few cents apart as one.")
maxDistPct = input.float(5.0, "Max trigger distance (%)", minval=0.1, step=0.1, group=grpCluster, tooltip="The highlighted trigger is the highest level within this distance of the close, so it clears the most levels available inside that range.")
maxRows = input.int(12, "Ladder rows to draw", minval=1, maxval=20, group=grpDisplay)
showTable = input.bool(true, "Show ladder table", group=grpDisplay)

volLen = input.int(10, "Volume average length", minval=1, group=grpVolume)
volMult = input.float(1.5, "Volume multiplier", minval=1.0, step=0.1, group=grpVolume)

cRung = input.color(color.new(color.silver, 45), "Ladder rung", group=grpColors)
cTrigger = input.color(color.new(color.orange, 0), "Trigger", group=grpColors)

// ─────────────────────────────────────────────────────────────────────────────
// Core series
// ─────────────────────────────────────────────────────────────────────────────
hi = ta.highest(high, lookback)
lo = ta.lowest(low, lookback)
swingRange = hi - lo

ema10 = ta.ema(close, 10)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
sma50 = ta.sma(close, 50)
sma100 = ta.sma(close, 100)
sma200 = ta.sma(close, 200)

volAvg = ta.sma(volume, volLen)
volRatio = volAvg > 0 ? volume / volAvg : na
volumeConfirmed = volume >= volAvg * volMult

// Bars required either side for a swing to count as a pivot. Larger values
// find only major swings; lower ones also mark minor lower-highs of the kind
// structural analysis calls a BOS or LH.
pivotLeft = input.int(5, "Pivot left bars", minval=1, maxval=25, group=grpCluster)
pivotRight = input.int(5, "Pivot right bars", minval=1, maxval=25, group=grpCluster)
ph = ta.pivothigh(high, pivotLeft, pivotRight)
pl = ta.pivotlow(low, pivotLeft, pivotRight)

// ─────────────────────────────────────────────────────────────────────────────
// Arrays and helpers
// ─────────────────────────────────────────────────────────────────────────────
var line[] lines = array.new_line()
var label[] labels = array.new_label()
var float[] pivotHighs = array.new_float()
var int[] pivotHighBars = array.new_int()
var float[] pivotLows = array.new_float()
var int[] pivotLowBars = array.new_int()
// Near-opaque so the white cell text stays legible on a light chart.
var table t = table.new(position.top_right, 3, 21, bgcolor=color.new(color.black, 8), border_width=1, border_color=color.new(color.gray, 70), frame_width=1, frame_color=color.new(color.gray, 50))

// Retain pivots by age, not by count. Evicting the oldest once a fixed number
// have accumulated drops a structurally important old high as soon as enough
// minor ones form, which is the wrong criterion for support and resistance: a
// swing high does not stop mattering because later swings happened. Age is the
// primary filter; the count is only a cap against unbounded growth.
//
// Both arrays are appended in chronological order, so the oldest entry is
// always at index 0 and pruning is a shift from the front.
f_prune(float[] vals, int[] bars, int maxAge, int cap) =>
    // The size check is a separate nested if rather than an `and` in the loop
    // condition, so this never depends on short-circuit evaluation to avoid
    // reading index 0 of an empty array.
    keepGoing = true
    while keepGoing
        keepGoing := false
        if array.size(bars) > 0
            if bar_index - array.get(bars, 0) > maxAge
                array.shift(bars)
                array.shift(vals)
                keepGoing := true
    while array.size(bars) > cap
        array.shift(bars)
        array.shift(vals)

// ta.pivothigh confirms pivotRight bars after the pivot itself, so the bar the
// pivot actually sits on is bar_index - pivotRight.
if not na(ph)
    array.push(pivotHighs, ph)
    array.push(pivotHighBars, bar_index - pivotRight)
if not na(pl)
    array.push(pivotLows, pl)
    array.push(pivotLowBars, bar_index - pivotRight)

// Runs every bar, not only when a pivot forms, so stale pivots age out.
f_prune(pivotHighs, pivotHighBars, pivotMaxAge, pivotCount)
f_prune(pivotLows, pivotLowBars, pivotMaxAge, pivotCount)

f_clear_drawings() =>
    if array.size(lines) > 0
        for i = 0 to array.size(lines) - 1
            line.delete(array.get(lines, i))
    array.clear(lines)
    if array.size(labels) > 0
        for i = 0 to array.size(labels) - 1
            label.delete(array.get(labels, i))
    array.clear(labels)

// Only levels above the close are resistance, so the filter lives here.
f_add_level(float[] arr, float v) =>
    if not na(v) and v > close
        array.push(arr, v)

f_fmt(float v) =>
    str.tostring(v, format.mintick)

f_pct(float v) =>
    str.tostring((v - close) / close * 100.0, "#.##") + "%"

// ─────────────────────────────────────────────────────────────────────────────
// Candidate levels
// ─────────────────────────────────────────────────────────────────────────────
var float[] candidates = array.new_float()
array.clear(candidates)

// Fib retracements from dominant swing leg
f_add_level(candidates, lo + swingRange * 0.236)
f_add_level(candidates, lo + swingRange * 0.382)
f_add_level(candidates, lo + swingRange * 0.5)
f_add_level(candidates, lo + swingRange * 0.618)
f_add_level(candidates, lo + swingRange * 0.786)

// MAs
f_add_level(candidates, ema10)
f_add_level(candidates, ema20)
f_add_level(candidates, ema50)
f_add_level(candidates, sma50)
f_add_level(candidates, sma100)
f_add_level(candidates, sma200)

// Pivots inside the age window, plus the swing extremes
if showPivots
    if array.size(pivotHighs) > 0
        for i = 0 to array.size(pivotHighs) - 1
            f_add_level(candidates, array.get(pivotHighs, i))
    if array.size(pivotLows) > 0
        for i = 0 to array.size(pivotLows) - 1
            f_add_level(candidates, array.get(pivotLows, i))

f_add_level(candidates, hi)
f_add_level(candidates, lo)

array.sort(candidates, order.ascending)

// ─────────────────────────────────────────────────────────────────────────────
// Ladder: distinct levels above the close, in ascending order
// ─────────────────────────────────────────────────────────────────────────────
// No banding. Position i in this array has cleared i + 1 levels, so the
// cumulative count is the index itself rather than a separate tally.
var float[] ladder = array.new_float()
array.clear(ladder)

dedupeTol = close * dedupePct / 100.0

if array.size(candidates) > 0
    for i = 0 to array.size(candidates) - 1
        lv = array.get(candidates, i)
        if array.size(ladder) == 0
            array.push(ladder, lv)
        else if lv - array.get(ladder, array.size(ladder) - 1) > dedupeTol
            array.push(ladder, lv)

// ─────────────────────────────────────────────────────────────────────────────
// Trigger: the highest rung inside the distance budget, which by construction
// clears the most levels available within that budget.
// ─────────────────────────────────────────────────────────────────────────────
float trigger = na
int cleared = na

if array.size(ladder) > 0
    for i = 0 to array.size(ladder) - 1
        lv = array.get(ladder, i)
        if (lv - close) / close * 100.0 <= maxDistPct
            trigger := lv
            cleared := i + 1

// The comparison is against the *previous* bar's trigger, not this bar's.
// f_add_level admits a level only when v > close, so every rung of the ladder,
// and therefore the trigger picked out of it, is above the close on its own bar
// by construction: `close > trigger` is unsatisfiable and the signal could
// never fire. The breakout this script means to report is a close above the
// rung that was inside the distance budget as of the previous bar, which is
// what prevTrigger holds.
//
// The old `close[1] <= trigger` leg is dropped rather than rewritten against
// prevTrigger: prevTrigger was above close[1] by the same construction that
// makes the lag necessary, so the test is always true and only costs a reader
// the time to prove it.
//
// A plain `var` carries the value rather than the history operator, because
// trigger is assigned inside a loop and this keeps the one-bar lag explicit at
// the point where it matters.
var float prevTrigger = na
var int prevCleared = na

confirmedBreak = not na(prevTrigger) and close > prevTrigger and volumeConfirmed

barcolor(confirmedBreak ? color.new(color.lime, 0) : na)

// ─────────────────────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(confirmedBreak, title="Volume-confirmed close breakout", message="Confluence Ladder: volume-confirmed close breakout")

// Reports the rung that was actually cleared, and the count it carried, which
// are the previous bar's values.
if confirmedBreak and barstate.isconfirmed
    alert(str.format("{0} closed above {1}, clearing {2} levels | volume={3}x average", syminfo.ticker, f_fmt(prevTrigger), str.tostring(prevCleared), str.tostring(volRatio, format.mintick)), alert.freq_once_per_bar_close)

// Carry this bar's trigger into the next bar. Must stay below every read of
// prevTrigger above, or the lag collapses and the signal goes dead again.
prevTrigger := trigger
prevCleared := cleared

// ─────────────────────────────────────────────────────────────────────────────
// Drawing
// ─────────────────────────────────────────────────────────────────────────────
if barstate.islast
    f_clear_drawings()

    if array.size(ladder) > 0
        drawn = int(math.min(array.size(ladder), maxRows))
        for i = 0 to drawn - 1
            lv = array.get(ladder, i)
            isTrigger = not na(trigger) and lv == trigger
            col = isTrigger ? cTrigger : cRung
            ln = line.new(bar_index - lookback, lv, bar_index, lv, extend=extend.right, color=col, width=isTrigger ? 2 : 1, style=isTrigger ? line.style_solid : line.style_dotted)
            array.push(lines, ln)
            txt = str.tostring(i + 1) + " cleared  @ " + f_fmt(lv) + "  (" + f_pct(lv) + ")"
            lb = label.new(bar_index, lv, txt, style=label.style_label_left, textcolor=color.white, color=isTrigger ? cTrigger : color.new(color.black, 100), size=size.tiny)
            array.push(labels, lb)

    // Info table
    if showTable
        table.clear(t, 0, 0, 2, 20)
        table.cell(t, 0, 0, "#", text_color=color.gray, text_size=size.tiny)
        table.cell(t, 1, 0, "level", text_color=color.gray, text_size=size.tiny)
        table.cell(t, 2, 0, "from close", text_color=color.gray, text_size=size.tiny)
        if array.size(ladder) > 0
            rows = int(math.min(array.size(ladder), maxRows))
            for i = 0 to rows - 1
                lv = array.get(ladder, i)
                isTrigger = not na(trigger) and lv == trigger
                tc = isTrigger ? color.orange : color.white
                table.cell(t, 0, i + 1, str.tostring(i + 1), text_color=tc, text_size=size.tiny)
                table.cell(t, 1, i + 1, f_fmt(lv), text_color=tc, text_size=size.tiny)
                table.cell(t, 2, i + 1, f_pct(lv), text_color=tc, text_size=size.tiny)
